# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Clerk authentication. The backend only needs the secret key; the frontend
# uses its own VITE_CLERK_PUBLISHABLE_KEY. There is no webhook endpoint yet.
CLERK_SECRET_KEY=sk_test_replace_me

# Optional one-time Owner bootstrap. Set this to the email address of the single
# Clerk user who should become the permanent OWNER. It is read *only* by the
# explicit `python -m app.commands.bootstrap_owner` command, never on the request
# path: the account must already exist (sign in once), be linked and active, and
# have a verified Clerk primary email matching this address. Matching is
# case-insensitive and whitespace-insensitive. The command refuses to run once an
# Owner exists, and ordinary sign-ups are always CUSTOMER. Leave empty to disable;
# the real address belongs in `.env` only, never in version control or data files.
INITIAL_ADMIN_EMAIL=

# Database. The project uses the psycopg (v3) async driver.
# Example: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/helpdesk

# Local development convenience: create missing tables on startup.
# Leave false in production and apply Alembic migrations instead
# (see backend/migrations/README).
AUTO_CREATE_TABLES=false
DATABASE_ECHO=false

# Where uploaded attachments are stored and the maximum upload size in bytes.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# Allowed browser origin for CORS and Clerk's authorized-party check (the
# frontend). Keep this to your real production origin.
FRONTEND_URL=http://localhost:5173

# Extra origins allowed in addition to FRONTEND_URL. Leave unset in production
# (only FRONTEND_URL is allowed); use it in local development when Vite falls
# back to another port. Comma-separated exact origins (scheme://host:port, no
# paths or trailing slashes) or a JSON array.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
