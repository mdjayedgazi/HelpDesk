# Copy this file to `.env` for local development. Never commit `.env`.

# Backend origin. Required for production builds; `npm run build` fails if it is
# missing, not HTTPS, or points at localhost.
VITE_API_URL=http://127.0.0.1:8000

# Clerk publishable key (safe to expose; it is not a secret). The backend uses
# the matching CLERK_SECRET_KEY and never sees this value.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# ---------------------------------------------------------------------------
# Docker/Nginx runtime settings (not read by Vite)
# ---------------------------------------------------------------------------
# The public backend origin added to the Content-Security-Policy connect-src.
# Must exactly match the VITE_API_URL baked into the JavaScript bundle.
API_ORIGIN=https://helpdesk-api.up.railway.app

# Clerk Frontend API origin for a custom Clerk domain. Leave unset to allow the
# default Clerk development hosts. Example: https://clerk.example.com
CLERK_FAPI_ORIGIN=

# Add HSTS only after the frontend domain has a verified TLS certificate.
HSTS_ENABLED=false
HSTS_MAX_AGE_SECONDS=31536000
